# Lokasi berkas SQLite. Bawaan: data/tenda.db di folder proyek. Tidak dipakai kalau DATABASE_URL diisi.
DB_PATH=
# Basis data PostgreSQL untuk hosting tanpa disk tetap seperti Vercel. Kalau basis data Neon dibuat dari dasbor
# Vercel dan disambungkan ke proyek, Vercel mengisinya sendiri. Kalau kosong, yang dipakai berkas SQLite di atas.
DATABASE_URL=
# Alamat situs untuk metadata dan sitemap, misalnya https://tendaindonesia.example
SITUS_URL=
# Kode untuk membuat akun admin pertama lewat /masuk saat basis data masih kosong. Minimal 16 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Tanpa kode ini, formulir admin pertama selalu menolak.
SETUP_TOKEN=
# Nama header berisi IP asli pengunjung yang ditulis ulang oleh proxy di depan aplikasi, misalnya x-real-ip
# (Nginx: proxy_set_header X-Real-IP $remote_addr;) atau cf-connecting-ip (Cloudflare).
# Jangan isi x-forwarded-for kecuali proxy membuang nilai kiriman pengunjung. Di Vercel boleh dikosongkan,
# karena x-real-ip dari Vercel dipakai otomatis. Di tempat lain, kosong berarti batas per alamat tidak dipakai.
HEADER_IP=
# Folder foto katalog. Bawaan: folder foto di samping berkas basis data (data/foto). Ikut cadangkan folder ini.
# Tidak dipakai kalau empat variabel R2 di bawah diisi.
FOTO_DIR=
# Penyimpanan foto di awan, untuk hosting tanpa disk tetap. Ada dua pilihan:
#  - Vercel Blob: buat Blob store privat di dasbor Vercel dan sambungkan ke proyek. Vercel mengisi
#    BLOB_READ_WRITE_TOKEN (atau BLOB_STORE_ID) sendiri, jadi tidak ada yang perlu ditulis di sini.
#  - Cloudflare R2: isi keempat variabel di bawah atau kosongkan semuanya. R2_ENDPOINT adalah alamat API S3
#    akun, bentuknya https://<id akun>.r2.cloudflarestorage.com. Kalau R2 dan Blob sama-sama terisi, R2 dipakai.
# Di keduanya penyimpanan boleh tetap privat, karena foto dilayani lewat /foto/<nama> di situs ini.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Mode demo untuk Vercel atau hosting lain tanpa disk tetap. Basis data dan foto ditaruh di /tmp dan diisi
# data contoh saat kosong, lalu hilang setiap server dimulai ulang. Hanya untuk pratinjau, bukan data asli.
# Kalau diisi bersama DATABASE_URL, data contohnya menetap di PostgreSQL itu (demo yang dicoba banyak orang).
MODE_DEMO=
# Kata sandi semua akun contoh di mode demo (admin, sales, gudang, kru, partner-tenda, partner-hka). Minimal 8.
SANDI_DEMO=
